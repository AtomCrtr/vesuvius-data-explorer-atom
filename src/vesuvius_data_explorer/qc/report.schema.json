{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "vesuvius-data-explorer"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string"
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "volume",
            "surface"
          ]
        },
        "uri": {
          "type": "string"
        },
        "level": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "level"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "samples_actual": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "max_voxels": {
          "type": "integer",
          "minimum": 0
        },
        "roi_width": {
          "type": "integer",
          "minimum": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "samples",
        "samples_actual",
        "seed",
        "max_voxels",
        "roi_width",
        "warnings",
        "thresholds"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "voxels_read": {
          "type": "integer",
          "minimum": 0
        },
        "chunks_touched": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "store_objects_touched": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "physical_io_note": {
          "type": "string"
        }
      },
      "required": [
        "voxels_read",
        "chunks_touched",
        "store_objects_touched",
        "physical_io_note"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "pass",
        "warn",
        "fail",
        "error",
        "skipped"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "required": [
    "schema_version",
    "tool",
    "created_at",
    "duration_s",
    "target",
    "parameters",
    "budget",
    "summary",
    "results"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vesuvius-data-explorer:qc-report:1.0",
  "$defs": {
    "location": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string"
        },
        "axis": {
          "enum": [
            "z",
            "y",
            "x"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "level",
        "axis",
        "index",
        "origin",
        "size"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "check_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "error",
            "skipped"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "threshold": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "message": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        }
      },
      "required": [
        "check_id",
        "status",
        "value",
        "threshold",
        "message",
        "locations"
      ],
      "additionalProperties": false
    }
  }
}
